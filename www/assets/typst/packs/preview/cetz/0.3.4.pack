#let tango-light-colors = (
  "fce94f", "fcaf3e", "e9b96e",
  "8ae234", "729fcf", "ad7fa8",
  "ef2929", "eeeeec", "888a85").map(rgb)
#let tango-dark-colors = (
  "c4a000", "ce5c00", "8f5902",
